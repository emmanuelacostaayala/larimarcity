generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model auth_group {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique()
  auth_group_permissions auth_group_permissions[]
  auth_user_groups       auth_user_groups[]
}

model auth_group_permissions {
  id              Int             @id @default(autoincrement())
  group_id        Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_group      auth_group      @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([group_id, permission_id])
  @@index([permission_id])
  @@index([group_id])
}

model auth_permission {
  id                         Int                          @id @default(autoincrement())
  content_type_id            Int
  codename                   String
  name                       String
  auth_group_permissions     auth_group_permissions[]
  django_content_type        django_content_type          @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user_user_permissions auth_user_user_permissions[]

  @@unique([content_type_id, codename])
  @@index([content_type_id])
}

model auth_user {
  id                                                                                 Int                             @id @default(autoincrement())
  password                                                                           String
  last_login                                                                         DateTime?
  is_superuser                                                                       Boolean
  username                                                                           String                          @unique()
  last_name                                                                          String
  email                                                                              String
  is_staff                                                                           Boolean
  is_active                                                                          Boolean
  date_joined                                                                        DateTime
  first_name                                                                         String
  auth_user_groups                                                                   auth_user_groups[]
  auth_user_user_permissions                                                         auth_user_user_permissions[]
  data_entry_broker                                                                  data_entry_broker?
  data_entry_closer                                                                  data_entry_closer?
  data_entry_formularioreserva_data_entry_formularioreserva_creado_por_idToauth_user data_entry_formularioreserva[]  @relation("data_entry_formularioreserva_creado_por_idToauth_user")
  data_entry_formularioreserva_data_entry_formularioreserva_vendedor_idToauth_user   data_entry_formularioreserva[]  @relation("data_entry_formularioreserva_vendedor_idToauth_user")
  data_entry_historialpropiedad                                                      data_entry_historialpropiedad[]
  data_entry_liner                                                                   data_entry_liner?
  data_entry_notificacion                                                            data_entry_notificacion[]
  data_entry_propiedad_data_entry_propiedad_reservada_por_idToauth_user              data_entry_propiedad[]          @relation("data_entry_propiedad_reservada_por_idToauth_user")
  data_entry_propiedad_data_entry_propiedad_autorizado_por_idToauth_user             data_entry_propiedad[]          @relation("data_entry_propiedad_autorizado_por_idToauth_user")
  data_entry_reservacliente_data_entry_reservacliente_broker_idToauth_user           data_entry_reservacliente[]     @relation("data_entry_reservacliente_broker_idToauth_user")
  data_entry_reservacliente_data_entry_reservacliente_vendedor_idToauth_user         data_entry_reservacliente[]     @relation("data_entry_reservacliente_vendedor_idToauth_user")
  data_entry_reservacompleta                                                         data_entry_reservacompleta[]
  django_admin_log                                                                   django_admin_log[]
}

model auth_user_groups {
  id         Int        @id @default(autoincrement())
  user_id    Int
  group_id   Int
  auth_group auth_group @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user  auth_user  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, group_id])
  @@index([group_id])
  @@index([user_id])
}

model auth_user_user_permissions {
  id              Int             @id @default(autoincrement())
  user_id         Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user       auth_user       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, permission_id])
  @@index([permission_id])
  @@index([user_id])
}

model data_entry_asignacionpropiedad {
  id                   Int                  @id @default(autoincrement())
  fecha_asignacion     DateTime
  fecha_fin            DateTime?
  estado               String
  notas                String
  fecha_creacion       DateTime
  fecha_actualizacion  DateTime
  broker_id            Int?
  propiedad_id         Int
  tipo_asignacion      String
  liner_id             Int?
  data_entry_liner     data_entry_liner?    @relation(fields: [liner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_propiedad data_entry_propiedad @relation(fields: [propiedad_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_broker    data_entry_broker?   @relation(fields: [broker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([propiedad_id, broker_id, liner_id, estado])
  @@index([liner_id])
  @@index([propiedad_id])
  @@index([broker_id])
}

model data_entry_asignacionproyecto {
  id                                                                           Int                 @id @default(autoincrement())
  tipo_asignacion                                                              String
  fecha_asignacion                                                             DateTime
  fecha_fin                                                                    DateTime?
  estado                                                                       String
  notas                                                                        String
  fecha_creacion                                                               DateTime
  fecha_actualizacion                                                          DateTime
  broker_id                                                                    Int?
  proyecto_id                                                                  Int
  closer_id                                                                    Int?
  kam_id                                                                       Int?
  liner_id                                                                     Int?
  data_entry_liner                                                             data_entry_liner?   @relation(fields: [liner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_closer_data_entry_asignacionproyecto_kam_idTodata_entry_closer    data_entry_closer?  @relation("data_entry_asignacionproyecto_kam_idTodata_entry_closer", fields: [kam_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_closer_data_entry_asignacionproyecto_closer_idTodata_entry_closer data_entry_closer?  @relation("data_entry_asignacionproyecto_closer_idTodata_entry_closer", fields: [closer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_proyecto                                                          data_entry_proyecto @relation(fields: [proyecto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_broker                                                            data_entry_broker?  @relation(fields: [broker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([proyecto_id, broker_id, liner_id, estado])
  @@index([liner_id])
  @@index([kam_id])
  @@index([closer_id])
  @@index([proyecto_id])
  @@index([broker_id])
}

model data_entry_broker {
  id                             Int                              @id @default(autoincrement())
  nombre                         String
  email                          String                           @unique()
  telefono                       String
  activo                         Boolean
  fecha_creacion                 DateTime
  fecha_actualizacion            DateTime
  user_id                        Int?                             @unique()
  rol_id                         Int?
  empresa                        String?
  closer_id                      Int?
  data_entry_asignacionpropiedad data_entry_asignacionpropiedad[]
  data_entry_asignacionproyecto  data_entry_asignacionproyecto[]
  data_entry_closer              data_entry_closer?               @relation(fields: [closer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_rol                 data_entry_rol?                  @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_user                      auth_user?                       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_liner               data_entry_liner[]
  data_entry_propiedad           data_entry_propiedad[]
  data_entry_reserva             data_entry_reserva[]

  @@index([closer_id])
  @@index([rol_id])
}

model data_entry_cliente {
  id                                         Int                                          @id @default(autoincrement())
  nombre                                     String
  email                                      String                                       @unique()
  telefono                                   String
  activo                                     Boolean
