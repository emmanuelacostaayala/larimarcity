  notas                                      String
  data_entry_cliente_propiedades_interesadas data_entry_cliente_propiedades_interesadas[]
  data_entry_reserva                         data_entry_reserva[]
}

model data_entry_cliente_propiedades_interesadas {
  id                   Int                  @id @default(autoincrement())
  cliente_id           Int
  propiedad_id         Int
  data_entry_propiedad data_entry_propiedad @relation(fields: [propiedad_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_cliente   data_entry_cliente   @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cliente_id, propiedad_id])
  @@index([propiedad_id])
  @@index([cliente_id])
}

model data_entry_closer {
  id                                                                                       Int                             @id @default(autoincrement())
  nombre                                                                                   String
