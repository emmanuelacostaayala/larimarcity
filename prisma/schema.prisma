  fecha_creacion                                                                           DateTime
  fecha_actualizacion                                                                      DateTime
  user_id                                                                                  Int?                            @unique()
  data_entry_asignacionproyecto_data_entry_asignacionproyecto_kam_idTodata_entry_closer    data_entry_asignacionproyecto[] @relation("data_entry_asignacionproyecto_kam_idTodata_entry_closer")
  data_entry_asignacionproyecto_data_entry_asignacionproyecto_closer_idTodata_entry_closer data_entry_asignacionproyecto[] @relation("data_entry_asignacionproyecto_closer_idTodata_entry_closer")
  data_entry_broker                                                                        data_entry_broker[]
  auth_user                                                                                auth_user?                      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  data_entry_liner                                                                         data_entry_liner[]
  data_entry_propiedad                                                                     data_entry_propiedad[]
